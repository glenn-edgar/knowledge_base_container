#!/usr/bin/env bash
# start.sh -- Watchdog wrapper for the DCS host process.
#
# Reads bootstrap.db (read-only sqlite, sliced from master pg KB) for identity
# + pg connect; restarts the host process on death; logs restart events to
# error.log. Debug mode: foreground, operator-launched.
#
# Layout (this file's directory):
#   start.sh           (this script)
#   bootstrap.db       (read-only, generated by laptop slicer)
#   error.log          (created on first run)
#
# The dcs binary lives in the repo at host_processes/dcs.lua and is invoked
# directly (no symlink in this dir).
#
# Usage: ./start.sh    (Ctrl-C exits the watchdog and the child)
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/error.log"
BOOTSTRAP="$SCRIPT_DIR/bootstrap.db"

# Ascend: build_output/<cpu>/ -> build_output -> nanodatacenter_dcs
DCS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DCS_BIN="$DCS_ROOT/host_processes/dcs.lua"
BB_ROOT="$DCS_ROOT/.."                            # building_blocks
SQLITE_KB_DIR="$BB_ROOT/knowledge_base/sqlite3/construct_kb"
CT_RUNTIME="$BB_ROOT/chain_tree_luajit/runtime"
CT_DSL="$BB_ROOT/chain_tree_luajit/lua_dsl"

[[ -r "$BOOTSTRAP" ]] || { echo "missing $BOOTSTRAP" >&2; exit 1; }
[[ -x "$DCS_BIN"   ]] || { echo "missing or not exec: $DCS_BIN" >&2; exit 1; }
[[ -r "$DCS_ROOT/chain_tree/dcs.json" ]] || { echo "missing chain_tree/dcs.json -- run chain_tree/build_dsl.sh" >&2; exit 1; }

export LUA_PATH="$DCS_ROOT/host_processes/?.lua;$CT_RUNTIME/?.lua;$CT_DSL/?.lua;$CT_DSL/lua_support/?.lua;$SQLITE_KB_DIR/?.lua;?.lua;;"
# cjson for LuaJIT 5.1
export LUA_CPATH="/usr/local/lib/lua/5.1/?.so;${LUA_CPATH:-};;"

SECRETS_FILE="${HOME}/.config/nanodatacenter/secrets.env"
if [[ -f "$SECRETS_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$SECRETS_FILE"
else
    echo "warning: $SECRETS_FILE not found; PG_PASSWORD will be unset" >&2
fi
export PG_PASSWORD POSTGRES_PASSWORD="${PG_PASSWORD:-}"

# Forward Ctrl-C / TERM so the watchdog loop ends cleanly.
trap 'echo "$(date -u +%FT%TZ) dcs watchdog stopping" >> "$LOG"; exit 0' INT TERM

echo "$(date -u +%FT%TZ) dcs watchdog starting (bootstrap=$BOOTSTRAP)" >> "$LOG"

while true; do
    echo "$(date -u +%FT%TZ) dcs starting" >> "$LOG"
    "$DCS_BIN" "$BOOTSTRAP" 2>>"$LOG"
    code=$?
    echo "$(date -u +%FT%TZ) dcs exited $code; restart in 2s" >> "$LOG"
    sleep 2
done
