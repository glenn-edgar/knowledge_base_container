#!/usr/bin/env bash
# start.sh -- Watchdog wrapper for the DCS host process.
#
# This script is placed into each deployment/<cpu>/ by slice_bootstrap.sh.
# It expects the runtime/ tree to be wired in (symlink or copy) alongside
# it by stage_deploy.sh. All paths are local to the CPU dir, so prod
# deployments can relocate the directory without breakage.
#
# Layout (this file's directory, after stage_deploy):
#   start.sh           (this script)
#   env.sh             (operator-owned PG_HOST/POSTGRES_PASSWORD/etc.)
#   bootstrap.db       (read-only, generated by laptop slicer)
#   runtime/           (symlink or copy of nanodatacenter_dcs/runtime/)
#   error.log          (created on first run)
#
# Usage: ./start.sh    (Ctrl-C exits the watchdog and the child)
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/error.log"
BOOTSTRAP="$SCRIPT_DIR/bootstrap.db"
RUNTIME="$SCRIPT_DIR/runtime"              # wired in by stage_deploy.sh
ENV_FILE="$SCRIPT_DIR/env.sh"

# Resolve runtime-adjacent building_blocks root by following runtime/ and
# ascending. Works whether runtime/ is a symlink (dev) or a copy (prod);
# in prod the readlink gives the local copy and BB_ROOT is this deployment
# dir, so siblings like chain_tree_luajit need to be present. For dev we
# follow the symlink back to the source tree.
RT_RESOLVED="$(readlink -f "$RUNTIME" 2>/dev/null || true)"
if [[ -z "$RT_RESOLVED" ]]; then RT_RESOLVED="$RUNTIME"; fi
DCS_ROOT="$(cd "$RT_RESOLVED/.." && pwd)"       # .../nanodatacenter_dcs (or equivalent in prod layout)
BB_ROOT="$DCS_ROOT/.."                          # building_blocks/

DCS_BIN="$RUNTIME/dcs_host/dcs.lua"
SQLITE_KB_DIR="$BB_ROOT/knowledge_base/sqlite3/construct_kb"
CT_RUNTIME="$BB_ROOT/chain_tree_luajit/runtime"
CT_DSL="$BB_ROOT/chain_tree_luajit/lua_dsl"

[[ -r "$BOOTSTRAP" ]]              || { echo "missing $BOOTSTRAP" >&2; exit 1; }
[[ -x "$DCS_BIN"   ]]              || { echo "missing or not exec: $DCS_BIN" >&2; exit 1; }
[[ -r "$RUNTIME/chain_tree/dcs.json" ]] || {
    echo "missing runtime/chain_tree/dcs.json -- run runtime/chain_tree/build_dsl.sh" >&2
    exit 1
}

export LUA_PATH="$RUNTIME/dcs_host/?.lua;$CT_RUNTIME/?.lua;$CT_DSL/?.lua;$CT_DSL/lua_support/?.lua;$SQLITE_KB_DIR/?.lua;?.lua;;"
# cjson for LuaJIT 5.1
export LUA_CPATH="/usr/local/lib/lua/5.1/?.so;${LUA_CPATH:-};;"

# Operator env (PG_HOST, POSTGRES_PASSWORD, etc). Seeded by stage_deploy.sh.
if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
fi

# Fallback: operator's secrets file (legacy path). If the env.sh already
# set POSTGRES_PASSWORD, this is a no-op.
SECRETS_FILE="${HOME}/.config/nanodatacenter/secrets.env"
if [[ -z "${POSTGRES_PASSWORD:-}" && -f "$SECRETS_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$SECRETS_FILE"
    export POSTGRES_PASSWORD="${PG_PASSWORD:-${POSTGRES_PASSWORD:-}}"
fi
export PG_PASSWORD="${PG_PASSWORD:-${POSTGRES_PASSWORD:-}}"

# Forward Ctrl-C / TERM so the watchdog loop ends cleanly.
trap 'echo "$(date -u +%FT%TZ) dcs watchdog stopping" >> "$LOG"; exit 0' INT TERM

echo "$(date -u +%FT%TZ) dcs watchdog starting (bootstrap=$BOOTSTRAP)" >> "$LOG"

while true; do
    echo "$(date -u +%FT%TZ) dcs starting" >> "$LOG"
    "$DCS_BIN" "$BOOTSTRAP" 2>>"$LOG"
    code=$?
    echo "$(date -u +%FT%TZ) dcs exited $code; restart in 2s" >> "$LOG"
    sleep 2
done
